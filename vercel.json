{
  "crons": [
    {
      "path": "/api/backup-export",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/daily-digest",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/google-calendar",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/wise-reconcile",
      "schedule": "0 6 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
