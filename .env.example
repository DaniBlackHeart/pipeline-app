VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Platform admin dashboard (/admin) -- TWO separate Vercel env vars are
# needed, both set to the SAME email address (yours). This is the same
# VITE_ vs non-VITE_ split as GOOGLE_CLIENT_SECRET above: the VITE_ one
# ships to the browser bundle and only controls whether the "Admin" nav
# link shows up; the non-VITE_ one stays server-only and is the actual
# security check in api/admin.js. Setting only one of the two is a real,
# easy-to-make mistake -- see the Google Calendar setup history in
# SETUP.md for what that class of bug looks like in practice.
VITE_PLATFORM_ADMIN_EMAIL=you@example.com
PLATFORM_ADMIN_EMAIL=you@example.com
